# --- API ---------------------------------------------------------------------
# Port the API binds to (default 8181).
PORT=8181
# Bind address: loopback by default. Set HOST=0.0.0.0 only behind a reverse
# proxy or inside containers (see docs/operations/deployment.md).
# HOST=0.0.0.0

NODE_ENV=development

# Database connection. Defaults to a local SQLite file for development.
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (see docs/operations/postgres.md and docker-compose.yml;
# password must match the compose POSTGRES_PASSWORD):
# DATABASE_URL="postgresql://grimoire:${POSTGRES_PASSWORD}@127.0.0.1:5432/grimoire?schema=public"

# JWT signing secret. MUST be replaced with a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Short-lived access token (default 15m). Legacy JWT_EXPIRES_IN still works as fallback.
JWT_ACCESS_EXPIRES_IN=15m
# JWT_EXPIRES_IN=7d

# Refresh tokens: plaintext is only returned once, server stores sha256. Default 7d.
JWT_REFRESH_EXPIRES_IN=7d

# CORS: development auto-allows any localhost / 127.0.0.1 origin. In production,
# only this comma-separated whitelist is accepted; the loader fails fast if missing.
CORS_ORIGIN=http://localhost:8180

# Set to 1 only when running behind a trusted reverse proxy. Direct exposure with
# TRUST_PROXY=1 lets clients forge X-Forwarded-For and bypass rate limits.
# TRUST_PROXY=1

# Log level: debug | info | warn | error (defaults: debug in development, info in production).
# LOG_LEVEL=info

# Static encryption key for BYOK apiKey values (>= 16 chars). When unset, falls back
# to a derivation of JWT_SECRET — fine for development, set a dedicated key in production.
# BYOK_ENCRYPTION_KEY=

# --- Web (Vite) -------------------------------------------------------------
# VITE_PORT=8180          # Vite dev server port (default 8180)
# VITE_API_PORT=8181      # Front-end /api proxy target (defaults to PORT or 8181; see README)
# Same-origin proxy mode (recommended): leave VITE_API_BASE_URL unset and the
# front-end will use the relative path /api/v1, with Vite's dev proxy forwarding it.
# Direct cross-origin (only when the front-end is hosted independently): uncomment
# and fill in the backend address; also configure production CORS_ORIGIN / CSP connect-src.
# VITE_API_BASE_URL=http://localhost:8181/api/v1

# --- Seed admin (db:seed) ---------------------------------------------------
# Password is REQUIRED; there is no built-in default.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
# Set to 1 to promote an existing user with the same email to super-admin.
# SEED_FORCE_ADMIN=1

# --- LLM providers (server-side only — never commit real keys) --------------
LLM_PROVIDER_ID=stepfun
STEPFUN_API_KEY=
# Anthropic-compatible: base only needs to reach /step_plan (auto /v1/messages).
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan
STEPFUN_MODEL=step-3.7-flash
STEPFUN_API_FORMAT=anthropic_messages
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_FORMAT=openai_chat
# Generic compatible gateway (optional).
# GENERIC_LLM_API_KEY=
# GENERIC_LLM_BASE_URL=
# GENERIC_LLM_MODEL=default
# GENERIC_LLM_API_FORMAT=openai_chat
# GENERIC_LLM_NAME=Generic
# GENERIC_LLM_VISION=false

# --- Agent tool-loop (panel ReAct; optional) --------------------------------
# TOOL_LOOP_MAX_ITERS=5
# TOOL_TIMEOUT_MS=8000
# TOOL_LOOP_OVERALL_MS=75000   # ReAct loop wall-clock; must be < the front-end tools-mode timeout (90s)

# --- LLM resilience (R-01 / R-02; optional, defaults shown) -----------------
# LLM_CIRCUIT_FAILURES=3        # Trip after N consecutive failures
# LLM_CIRCUIT_OPEN_MS=30000     # Cooldown; fast 503 during open
# LLM_MAX_CONCURRENT=12         # In-process cap on concurrent LLM calls
# LLM_QUEUE_WAIT_MS=5000        # Wait when at cap; 503 on timeout

# R-04: fall back to a server-side provider when BYOK fails (off by default,
# keep disabled to honor per-user quota isolation).
# LLM_BYOK_FALLBACK_TO_SERVER=1
