# Install devDependencies even when shell NODE_ENV=production
# (needed for local monorepo development with Vite, Vitest, etc.)
production=false

# Strict peer dependency resolution; failures surface immediately
strict-peer-dependencies=false
auto-install-peers=true

# Skip lifecycle scripts for unknown packages by default;
# add to pnpm-workspace.yaml `onlyBuiltDependencies` to opt in.
enable-pre-post-scripts=true
