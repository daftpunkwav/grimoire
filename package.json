{
  "name": "grimoire",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Grimoire — interactive Agent / LLM learning platform (modular monolith, business-domain workspaces).",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @grimoire/web dev",
    "dev:api": "pnpm --filter @grimoire/api dev",
    "start:api": "pnpm --filter @grimoire/api start",
    "build:web": "pnpm --filter @grimoire/web build",
    "build:api": "pnpm --filter @grimoire/api build",
    "db:generate": "pnpm --filter @grimoire/api db:generate",
    "db:migrate": "pnpm --filter @grimoire/api db:migrate",
    "db:seed": "pnpm --filter @grimoire/api db:seed",
    "db:reset": "pnpm --filter @grimoire/api db:reset",
    "test": "pnpm boundaries && vitest run",
    "test:coverage": "pnpm boundaries && vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check:deps": "node scripts/check-package-deps.mjs",
    "check:exports": "node scripts/check-export-tests.mjs",
    "check:i18n": "pnpm --filter @grimoire/web check:i18n",
    "lint": "pnpm -r --if-present lint",
    "verify": "pnpm -r build && pnpm -r typecheck && pnpm typecheck:tests && pnpm test:coverage && pnpm boundaries && pnpm check:deps && pnpm check:exports && pnpm lint"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
